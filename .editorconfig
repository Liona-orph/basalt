root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
# Matches rustfmt: 4 spaces, 100 columns.
max_line_length = 100

[*.{md,yml,yaml,toml,json}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[LICENSE]
trim_trailing_whitespace = false
insert_final_newline = false
